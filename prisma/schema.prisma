/// Prisma schema — Arsaba V2
/// Berdasarkan SPESIFIKASI_SISTEM.md §3, §4.1, §4.3, §6, §7, §8
/// Catatan: User & Employee digabung jadi satu model (satu orang = satu akun login = satu data karyawan)
/// supaya tidak ada relasi ganda yang saling tumpang tindih.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============ ENUMS ============

enum Role {
  DIREKTUR
  MANAJER
  SUPERVISOR
  ADMIN
  KEPALA_TOKO
  KARYAWAN
}

enum StatusKaryawan {
  AKTIF
  RESIGN
  NONAKTIF
}

enum TipePerhitunganGaji {
  HARIAN
  BULANAN
  JAM
}

enum SumberAgenda {
  TEMPLATE_PUSAT
  MANDIRI_KARYAWAN
}

enum StatusVerifikasi {
  PENDING_VERIFIKASI
  DIVERIFIKASI
  DITOLAK
}

enum JenisAbsen {
  MASUK
  KELUAR
}

enum StatusJadwal {
  DRAFT
  APPROVED
}

enum SumberJadwal {
  AUTO
  MANUAL
}

enum SegmenShift {
  NORMAL
  PAM
}

enum JenisHariTemplate {
  SEMUA
  WEEKDAY
  WEEKEND
  KUSTOM
}

enum TujuanSetoran {
  TOKO
  PUSAT
}

enum StatusSetoran {
  MENUNGGU_KONFIRMASI
  DITERIMA
  DIBATALKAN
}

enum JenisBuktiSetoran {
  SETOR
  TERIMA
}

// ============ USER / KARYAWAN ============
// Satu model untuk semua peran: Direktur, Manajer, Supervisor, Admin, Kepala Toko, Karyawan.

model User {
  id             String    @id @default(cuid())
  kode           String    @unique // identifier login auto-increment: DIR-001, MGR-001, EMP-001
  nama           String
  hashedPassword String? // nullable: migrasi data lama belum punya password
  image          String?

  role                Role                 @default(KARYAWAN)
  status              StatusKaryawan       @default(AKTIF)
  // Absen tanpa punya ShiftInstance APPROVED pada tanggal check-in.
  // Default false: karyawan harus punya jadwal, kalau tidak hubungi admin.
  bolehAbsenTanpaShift Boolean            @default(false)
  tipePerhitunganGaji TipePerhitunganGaji?
  // Tarif per jam — dipakai HANYA saat tipePerhitunganGaji = JAM.
  tarifPerJam          Int?
  // Tarif per hari — dipakai HANYA saat tipePerhitunganGaji = HARIAN.
  // Dipisah dari tarifPerJam karena jam kerja berbeda per toko, jadi rate
  // harian TIDAK bisa diturunkan dari tarifPerJam × konstanta jam (lihat §7.1).
  tarifPerHari         Int?
  tanggalMasuk        DateTime?

  // --- Data pribadi (PII) — akses baca/tulis untuk Admin, Supervisor, dan Manajer (§4.3, §11) ---
  nik           String?   @unique
  tempatLahir   String?
  tanggalLahir  DateTime?
  alamat        String?
  kontakDarurat String?

  // Penempatan toko saat ini (nullable untuk Direktur yang tidak terikat satu toko)
  storeId String?
  store   Store?  @relation("StoreEmployees", fields: [storeId], references: [id])

  // --- Relasi ---
  attendances         Attendance[] @relation("EmployeeAttendances")
  verifiedLogs AttendanceLog[] @relation("VerifierLogs")
  koreksiJamAttendance Attendance[] @relation("KoreksiJamOleh")

  shiftInstancesCreated   ShiftInstance[]   @relation("JadwalCreator")
  shiftInstancesApproved  ShiftInstance[]   @relation("JadwalApprover")
  shiftAssignments        ShiftAssignment[] @relation("EmployeeShifts")
  shiftAssignmentsCreated ShiftAssignment[] @relation("AssignmentCreator")

  agendasCreated  Agenda[] @relation("AgendaCreator")
  agendasVerified Agenda[] @relation("AgendaVerifier")
  agendasNominalSet Agenda[] @relation("AgendaNominalSetter")
  agendasTargeted Agenda[] @relation("AgendaTarget")

  riwayatPenempatan RiwayatPenempatan[] @relation("RiwayatEmployee")
  auditLogs         AuditLog[]          @relation("AuditActor")

  gajiPokok GajiPokok?
  payrolls  Payroll[]

  izins        Izin[] @relation("IzinEmployee")
  izinsCreated Izin[] @relation("IzinCreator")

  setoranDibuat     SetoranUang[] @relation("SetoranPengirim")
  setoranDiterima   SetoranUang[] @relation("SetoranPenerima")
  setoranDibatalkan SetoranUang[] @relation("SetoranPembatal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([storeId])
  @@index([status])
}

// ============ TOKO ============

model Store {
  id    String  @id @default(cuid())
  nama  String
  // Alias nama lama, lihat §4.1/§4.3: "DAPUR RUMAH" → "Dapur Produksi", "ARSABA DIENG" → "Counter Dieng"
  alias String?
  aktif Boolean @default(true)
  pamEnabled Boolean @default(true)

  employees    User[]        @relation("StoreEmployees")
  attendances  Attendance[]
  agendas      Agenda[]
  salesRecords SalesRecord[]

  riwayatDari RiwayatPenempatan[] @relation("RiwayatDariToko")
  riwayatKe   RiwayatPenempatan[] @relation("RiwayatKeToko")

  shiftTemplates ShiftTemplate[]
  shiftInstances ShiftInstance[]

  setoranDari   SetoranUang[] @relation("SetoranDariStore")
  setoranTujuan SetoranUang[] @relation("SetoranTujuanStore")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Riwayat mutasi/resign karyawan — jangan pernah hard-delete karyawan (§8)
model RiwayatPenempatan {
  id                 String   @id @default(cuid())
  employee           User     @relation("RiwayatEmployee", fields: [employeeId], references: [id])
  employeeId         String
  dariToko           Store?   @relation("RiwayatDariToko", fields: [dariTokoId], references: [id])
  dariTokoId         String?
  keToko             Store    @relation("RiwayatKeToko", fields: [keTokoId], references: [id])
  keTokoId           String
  tanggalPerpindahan DateTime @default(now())
  alasan             String?
  createdAt          DateTime @default(now())

  @@index([employeeId])
}

// ============ ABSENSI ============

model Attendance {
  id         String @id @default(cuid())
  employee   User   @relation("EmployeeAttendances", fields: [employeeId], references: [id])
  employeeId String
  // Nullable: Supervisor/Admin bisa check-in tanpa terikat toko (§5.1).
  // Kehadiran dihitung dari tanggalShift unik, tidak bergantung toko.
  store   Store? @relation(fields: [storeId], references: [id])
  storeId String?

  tanggalShift DateTime  @db.Date

  // Kapan karyawan dianggap masuk/pulang (dari log pertama untuk masuk,
  // dari log terbaru untuk keluar). Auto-close MENGISI absenKeluar dengan
  // jamSelesai shift (fallback absenMasuk) supaya karyawan bisa check-in lagi.
  absenMasuk  DateTime
  absenKeluar DateTime?

  // Kapan foto yang dipakai diambil (bisa beda dari absenMasuk/absenKeluar
  // kalau ada resubmit). Auto-close tidak mengisi ini.
  fotoMasukDiambilPada  DateTime
  fotoKeluarDiambilPada DateTime?

  menitTelat Int @default(0)
  potongan   Int @default(0)

  // Status verifikasi per bagian
  statusMasuk  StatusVerifikasi @default(PENDING_VERIFIKASI)
  statusKeluar StatusVerifikasi @default(PENDING_VERIFIKASI)

  // Auto-close untuk shift yang tidak check-out (> 20 jam)
  autoClosed   Boolean   @default(false)
  autoClosedAt DateTime?
  isPam        Boolean   @default(false)
  totalMenitKerja Int @default(0)

  // Koreksi jam kerja manual (P0-7, spesifikasi §7.1a) — HANYA untuk tipe JAM.
  // null = pakai totalMenitKerja apa adanya. Nilai server TIDAK PERNAH diubah
  // supaya asal-usul angka tetap terlihat.
  totalMenitManual Int?
  koreksiJamAlasan String?
  koreksiJamOlehId String?
  koreksiJamPada   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs AttendanceLog[]

  // Relasi siapa yang mengoreksi jam kerja manual (§7.1a).
  koreksiJamOleh User? @relation("KoreksiJamOleh", fields: [koreksiJamOlehId], references: [id])

  @@index([employeeId])
  @@index([storeId])
  @@index([statusMasuk])
  @@index([statusKeluar])
  @@index([autoClosed])
}

model AttendanceLog {
  id           String     @id @default(cuid())
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  attendanceId String

  jenis JenisAbsen

  // Foto bukti. Nullable untuk kasus admin override tanpa foto.
  fotoFileId String?
  latitude   Float?
  longitude  Float?

  // Waktu server — authoritative. Auto-close tidak mengisi ini.
  absenServerPada DateTime

  status       StatusVerifikasi @default(PENDING_VERIFIKASI)
  verifiedBy   User?            @relation("VerifierLogs", fields: [verifiedById], references: [id])
  verifiedById String?
  verifiedAt   DateTime?
  rejectedReason String?

  // Untuk resubmit: kenapa karyawan mengirim ulang
  keteranganKoreksi String?

  // Untuk override oleh admin (mis. karyawan lupa check-out, admin isi manual)
  isOverride Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([jenis])
  @@index([status])
  // Dipakai untuk otorisasi proxy foto di /api/telegram/file/[fileId]
  @@index([fotoFileId])
}

// ============ IZIN (KETIDAKHADIRAN BERALASAN) ============
// Satu record = satu tanggal (§8.1 laporan kehadiran: "Hari Izin").
// Range izin (mis. Senin–Rabu) dipecah server menjadi record per hari.
// @@unique([employeeId, tanggal]) mencegah penandaan dobel.
model Izin {
  id          String   @id @default(cuid())
  employee    User     @relation("IzinEmployee", fields: [employeeId], references: [id])
  employeeId  String
  tanggal     DateTime @db.Date
  alasan      String
  createdBy   User?    @relation("IzinCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, tanggal])
  @@index([employeeId])
  @@index([tanggal])
}

model ShiftTemplate {
  id             String   @id @default(cuid())
  store          Store    @relation(fields: [storeId], references: [id])
  storeId        String
  nama           String
  jamMulaiMenit  Int
  jamSelesaiMenit Int
  lintasHari     Boolean  @default(false)
  aktif          Boolean  @default(true)
  // Pola hari kerja: 0=Minggu, 1=Senin, ..., 6=Sabtu
  // Array kosong = SEMUA hari (backward compatible)
  hariKerja      Int[]    @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  instances ShiftInstance[]

  @@unique([storeId, nama])
  @@index([storeId])
}

model ShiftInstance {
  id           String         @id @default(cuid())
  store        Store          @relation(fields: [storeId], references: [id])
  storeId      String
  template     ShiftTemplate? @relation(fields: [templateId], references: [id])
  templateId   String?
  tanggal      DateTime       @db.Date
  jamMulai     DateTime
  jamSelesai   DateTime
  statusJadwal StatusJadwal   @default(DRAFT)
  sumberJadwal SumberJadwal
  catatan      String?

  createdBy    User           @relation("JadwalCreator", fields: [createdById], references: [id])
  createdById  String
  approvedBy   User?          @relation("JadwalApprover", fields: [approvedById], references: [id])
  approvedById String?
  approvedAt   DateTime?

  batchId     String?

  assignments ShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, tanggal])
  @@index([statusJadwal])
  @@index([batchId])
}

model ShiftAssignment {
  id                  String        @id @default(cuid())
  shiftInstance       ShiftInstance @relation(fields: [shiftInstanceId], references: [id], onDelete: Cascade)
  shiftInstanceId     String
  employee            User          @relation("EmployeeShifts", fields: [employeeId], references: [id])
  employeeId          String
  segmen              SegmenShift   @default(NORMAL)
  jamMulai            DateTime
  jamSelesai          DateTime

  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shiftInstanceId])
  @@index([employeeId])
  @@index([segmen])
}

// ============ AGENDA & BONUS ============
// Dua sumber (§6): template_pusat (dibuat Manajer/Supervisor/Admin) & mandiri_karyawan (laporan sendiri).

model Agenda {
  id        String       @id @default(cuid())
  judul     String
  deskripsi String?
  nominal   Int? // bonus per agenda, diisi Manajer setelah verifikasi
  sumber    SumberAgenda

  // Self-relation: agenda ini adalah turunan dari template induk (nullable)
  template   Agenda?  @relation("AgendaTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?
  turunan    Agenda[] @relation("AgendaTemplate")

  // Target opsional: agenda bisa berlaku umum, ke toko tertentu, atau ke karyawan tertentu (§6)
  targetStore      Store?  @relation(fields: [targetStoreId], references: [id])
  targetStoreId    String?
  targetEmployee   User?   @relation("AgendaTarget", fields: [targetEmployeeId], references: [id])
  targetEmployeeId String?

  // Deadline agenda — di-set manajer, nullable (agenda tanpa deadline tetap valid)
  deadline DateTime?

  createdBy   User   @relation("AgendaCreator", fields: [createdById], references: [id])
  createdById String

  status       StatusVerifikasi @default(PENDING_VERIFIKASI)
  verifiedBy   User?            @relation("AgendaVerifier", fields: [verifiedById], references: [id])
  verifiedById String?
  verifiedAt   DateTime?

  // Kapan & siapa yang set nominal (manajer)
  nominalSetBy   User?     @relation("AgendaNominalSetter", fields: [nominalSetById], references: [id])
  nominalSetById String?
  nominalSetAt   DateTime?

  // Bukti penyelesaian (foto, file_id Telegram) — opsional, boleh salah satu atau keduanya
  buktiBeforeFileId String?
  buktiAfterFileId  String?

  // Kapan karyawan menandai agenda ini selesai
  diselesaikanPada DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sumber])
  @@index([status])
  @@index([targetStoreId])
  @@index([targetEmployeeId])
  @@index([templateId])
  @@index([deadline])
  @@index([nominalSetById])
}

// ============ GAJI & PAYROLL (§7) ============

model GajiPokok {
  id         String   @id @default(cuid())
  employee   User     @relation(fields: [employeeId], references: [id])
  employeeId String   @unique
  nominal    Int // ditentukan pusat (Manajer), bukan per toko (§7.1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Satu record per karyawan per bulan — dipakai untuk tipe HARIAN maupun BULANAN,
// bedanya hanya cara `totalGaji` dihitung di level aplikasi (§7.1).
model Payroll {
  id         String   @id @default(cuid())
  employee   User     @relation(fields: [employeeId], references: [id])
  employeeId String
  periode    DateTime // tanggal 1 di bulan terkait, contoh: 2026-09-01

  gajiPokok               Int
  totalHariKerja          Int? // relevan untuk tipe HARIAN
  totalBonusAgenda        Int     @default(0) // dari agenda terverifikasi (§6)
  totalPotonganTelat      Int     @default(0) // dari akumulasi Attendance.potongan (§5.1)
  bonusManual             Int     @default(0) // input manual Manajer (§7.1)
  potonganManual          Int     @default(0) // input manual Manajer (§7.1)
  bonusPerforma           Int     @default(0) // manual sepenuhnya, TIDAK dihitung otomatis (§7.1)
  keteranganBonusPerforma String?

  totalGaji Int // hasil akhir setelah semua komponen di atas dijumlah/dikurangi

  status     String    @default("DRAFT") // DRAFT | LOCKED
  lockedAt   DateTime?
  lockedById String?

  // Jejak revisi (§7.1b). Sekali LOCKED payroll tidak bisa diubah langsung;
  // koreksi dilakukan lewat unlock-with-audit yang menaikkan revisiKe.
  revisiKe     Int       @default(0)
  revisiAlasan String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periode])
  @@index([periode])
  @@index([status])
}

// ============ AUDIT LOG (§8, §11) ============

model AuditLog {
  id           String   @id @default(cuid())
  tabel        String // nama tabel/entitas yang diubah
  recordId     String // id record yang diubah
  aksi         String // "CREATE" | "UPDATE" | "DELETE"
  nilaiSebelum Json?
  nilaiSesudah Json?
  actor        User     @relation("AuditActor", fields: [actorId], references: [id])
  actorId      String
  alasan       String?
  createdAt    DateTime @default(now())

  @@index([tabel, recordId])
  @@index([actorId])
}

// ============ KODE COUNTER USER ============
// Auto-increment per prefix (DIR, MGR, EMP). Dipakai generate kode user baru.

model KodeCounter {
  prefix     String @id // "DIR" | "MGR" | "EMP"
  lastNumber Int    @default(0)
}

// ============ MODUL PENJUALAN PER TOKO (§4.2) ============
// Sengaja generik (kolom `data` berupa JSON) karena tiap modul (Epos, Brilink, Pulsa,
// Bensin, Nota Harian, Komoditas) punya field berbeda — lihat §4.2 untuk struktur JSON per modul.

model SalesRecord {
  id         String   @id @default(cuid())
  store      Store    @relation(fields: [storeId], references: [id])
  storeId    String
  tanggal    DateTime
  shift      String?
  modul      String // "EPOS" | "BRILINK" | "PULSA" | "BENSIN" | "NOTA_HARIAN" | "KOMODITAS"
  sumberData String   @default("manual") // "manual" | "sinkron_epos" (§4.2.1)
  data       Json // struktur field mengikuti modul, lihat §4.2.1–§4.2.7

  createdAt DateTime @default(now())

  @@index([storeId, tanggal])
  @@index([modul])
}

// ============ PENYETORAN UANG ANTAR TOKO & PUSAT ============
// Jejak transfer kas tunai antar toko / ke kantor pusat, tercatat by tanggal & pelaku,
// dengan bukti foto multi-file di kedua sisi (SETOR & TERIMA).
// v1: TIDAK terkait saldo kas / SalesRecord / omset Epos (jejak transfer saja).
// Tujuan PUSAT netral: tokoTujuanId = null (belum ada Store pusat).
// nominalDisetor immutable setelah submit; selisih dihitung server saat konfirmasi.

model SetoranUang {
  id          String        @id @default(cuid())
  dariStore   Store         @relation("SetoranDariStore", fields: [dariStoreId], references: [id])
  dariStoreId String
  tipeTujuan  TujuanSetoran
  tokoTujuan  Store?        @relation("SetoranTujuanStore", fields: [tokoTujuanId], references: [id])
  tokoTujuanId String? // null saat PUSAT

  nominalDisetor Int // immutable setelah submit
  keterangan     String? // opsional, max 200

  status StatusSetoran @default(MENUNGGU_KONFIRMASI)

  disetorkanOleh   User     @relation("SetoranPengirim", fields: [disetorkanOlehId], references: [id])
  disetorkanOlehId String
  disetorkanPada   DateTime // WIB

  // Bucket menit = date_trunc('minute', disetorkanPada), diisi oleh TRIGGER
  // database (lihat migration 20260930120000_setoran_anti_duplikat).
  //
  // `@ignore` itu disengaja, bukan sisa.:
  //   - Kolom ini TIDAK muncul di Prisma Client, jadi aplikasi secara fisik
  //     tidak bisa mengirimnya. inilah yang membuat unique index benar-benar
  //     tidak bisa dilewati dari sisi client.
  //   - TypeScript juga tidak menuntut field ini di setiap `create`.
  //   - `prisma migrate diff` tetap melaporkan "empty migration", jadi tidak ada
  //     drift walau kolom ini diabaikan Prisma.
  //
  // Kenapa trigger, bukan `@default`: kolom dengan DEFAULT masih bisa diisi
  // manual dari client, jadi penjaga unique index bisa dilewati. Trigger tidak.
  //
  // JANGAN HAPUS `@ignore` tanpa menyelesaikan ulang strateginya — kalau kolom ini
  // muncul di Client, anti-duplikat bisa dilewati.
  menitBucket DateTime @ignore

  nominalDiterima   Int?
  selisih           Int? // diterima − disetor (dihitung server)
  keteranganSelisih String? // WAJIB bila selisih ≠ 0
  diterimaOleh      User?    @relation("SetoranPenerima", fields: [diterimaOlehId], references: [id])
  diterimaOlehId    String?
  diterimaPada      DateTime?

  batalOleh   User?    @relation("SetoranPembatal", fields: [batalOlehId], references: [id])
  batalOlehId String?
  batalPada   DateTime?
  alasanBatal String?

  bukti BuktiSetoran[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dariStoreId])
  @@index([tokoTujuanId])
  @@index([tipeTujuan])
  @@index([status])
  @@index([disetorkanPada])

  // Anti transfer ganda: satu setoran per (toko pengirim, nominal, menit).
  // Retry beberapa detik setelah timeout, atau double-click, akan kena P2002
  // dan ditolak — bukan terhitung dua kali di pusat.
  @@unique([dariStoreId, nominalDisetor, menitBucket], name: "SetoranUang_dariStoreId_nominalDisetor_menitBucket_key")
  @@index([menitBucket])
}

model BuktiSetoran {
  id        String            @id @default(cuid())
  setoran   SetoranUang       @relation(fields: [setoranId], references: [id], onDelete: Cascade)
  setoranId String
  jenis     JenisBuktiSetoran
  fileId    String // Telegram file_id — JANGAN simpan URL
  namaFile  String? // nama asli file (opsional)
  createdAt DateTime          @default(now())

  @@index([setoranId])
  @@index([jenis])
}
