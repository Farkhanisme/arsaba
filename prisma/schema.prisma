/// Prisma schema — Arsaba V2
/// Berdasarkan SPESIFIKASI_SISTEM.md §3, §4.1, §4.3, §6, §7, §8
/// Catatan: User & Employee digabung jadi satu model (satu orang = satu akun login = satu data karyawan)
/// supaya tidak ada relasi ganda yang saling tumpang tindih.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============ ENUMS ============

enum Role {
  DIREKTUR
  MANAJER
  SUPERVISOR
  ADMIN
  KEPALA_TOKO
  KARYAWAN
}

enum StatusKaryawan {
  AKTIF
  RESIGN
  NONAKTIF
}

enum TipePerhitunganGaji {
  HARIAN
  BULANAN
  JAM
}

enum SumberAgenda {
  TEMPLATE_PUSAT
  MANDIRI_KARYAWAN
}

enum StatusVerifikasi {
  PENDING_VERIFIKASI
  DIVERIFIKASI
  DITOLAK
}

enum JenisAbsen {
  MASUK
  KELUAR
}

enum StatusJadwal {
  DRAFT
  APPROVED
}

enum SumberJadwal {
  AUTO
  MANUAL
}

enum SegmenShift {
  NORMAL
  PAM
}

enum JenisHariTemplate {
  SEMUA
  WEEKDAY
  WEEKEND
  KUSTOM
}

// ============ USER / KARYAWAN ============
// Satu model untuk semua peran: Direktur, Manajer, Supervisor, Admin, Kepala Toko, Karyawan.

model User {
  id             String    @id @default(cuid())
  kode           String    @unique // identifier login auto-increment: DIR-001, MGR-001, EMP-001
  nama           String
  hashedPassword String? // nullable: migrasi data lama belum punya password
  image          String?

  role                Role                 @default(KARYAWAN)
  status              StatusKaryawan       @default(AKTIF)
  tipePerhitunganGaji TipePerhitunganGaji?
  tarifPerJam          Int?
  tanggalMasuk        DateTime?

  // --- Data pribadi (PII) — akses baca/tulis dibatasi Admin & Manajer saja di level aplikasi (§3, §11) ---
  nik           String?   @unique
  tempatLahir   String?
  tanggalLahir  DateTime?
  alamat        String?
  kontakDarurat String?

  // Penempatan toko saat ini (nullable untuk Direktur yang tidak terikat satu toko)
  storeId String?
  store   Store?  @relation("StoreEmployees", fields: [storeId], references: [id])

  // --- Relasi ---
  attendances         Attendance[] @relation("EmployeeAttendances")
  verifiedLogs AttendanceLog[] @relation("VerifierLogs")

  shiftInstancesCreated   ShiftInstance[]   @relation("JadwalCreator")
  shiftInstancesApproved  ShiftInstance[]   @relation("JadwalApprover")
  shiftAssignments        ShiftAssignment[] @relation("EmployeeShifts")
  shiftAssignmentsCreated ShiftAssignment[] @relation("AssignmentCreator")

  agendasCreated  Agenda[] @relation("AgendaCreator")
  agendasVerified Agenda[] @relation("AgendaVerifier")
  agendasNominalSet Agenda[] @relation("AgendaNominalSetter")
  agendasTargeted Agenda[] @relation("AgendaTarget")

  riwayatPenempatan RiwayatPenempatan[] @relation("RiwayatEmployee")
  auditLogs         AuditLog[]          @relation("AuditActor")

  gajiPokok GajiPokok?
  payrolls  Payroll[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([storeId])
  @@index([status])
}

// ============ TOKO ============

model Store {
  id    String  @id @default(cuid())
  nama  String
  // Alias nama lama, lihat §4.1/§4.3: "DAPUR RUMAH" → "Dapur Produksi", "ARSABA DIENG" → "Counter Dieng"
  alias String?
  aktif Boolean @default(true)
  pamEnabled Boolean @default(true)

  employees    User[]        @relation("StoreEmployees")
  attendances  Attendance[]
  agendas      Agenda[]
  salesRecords SalesRecord[]

  riwayatDari RiwayatPenempatan[] @relation("RiwayatDariToko")
  riwayatKe   RiwayatPenempatan[] @relation("RiwayatKeToko")

  shiftTemplates ShiftTemplate[]
  shiftInstances ShiftInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Riwayat mutasi/resign karyawan — jangan pernah hard-delete karyawan (§8)
model RiwayatPenempatan {
  id                 String   @id @default(cuid())
  employee           User     @relation("RiwayatEmployee", fields: [employeeId], references: [id])
  employeeId         String
  dariToko           Store?   @relation("RiwayatDariToko", fields: [dariTokoId], references: [id])
  dariTokoId         String?
  keToko             Store    @relation("RiwayatKeToko", fields: [keTokoId], references: [id])
  keTokoId           String
  tanggalPerpindahan DateTime @default(now())
  alasan             String?
  createdAt          DateTime @default(now())

  @@index([employeeId])
}

// ============ ABSENSI ============

model Attendance {
  id         String @id @default(cuid())
  employee   User   @relation("EmployeeAttendances", fields: [employeeId], references: [id])
  employeeId String
  store      Store  @relation(fields: [storeId], references: [id])
  storeId    String

  tanggalShift DateTime  @db.Date

  // Kapan karyawan dianggap masuk/pulang (dari log pertama untuk masuk,
  // dari log terbaru untuk keluar). Auto-close tidak mengisinya.
  absenMasuk  DateTime
  absenKeluar DateTime?

  // Kapan foto yang dipakai diambil (bisa beda dari absenMasuk/absenKeluar
  // kalau ada resubmit)
  fotoMasukDiambilPada  DateTime
  fotoKeluarDiambilPada DateTime?

  menitTelat Int @default(0)
  potongan   Int @default(0)

  // Status verifikasi per bagian
  statusMasuk  StatusVerifikasi @default(PENDING_VERIFIKASI)
  statusKeluar StatusVerifikasi @default(PENDING_VERIFIKASI)

  // Auto-close untuk shift yang tidak check-out
  autoClosed   Boolean   @default(false)
  autoClosedAt DateTime?
  isPam        Boolean   @default(false)
  totalMenitKerja Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs AttendanceLog[]

  @@index([employeeId])
  @@index([storeId])
  @@index([statusMasuk])
  @@index([statusKeluar])
  @@index([autoClosed])
}

model AttendanceLog {
  id           String     @id @default(cuid())
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  attendanceId String

  jenis JenisAbsen

  // Foto bukti. Nullable untuk kasus admin override tanpa foto.
  fotoFileId String?
  latitude   Float?
  longitude  Float?

  // Waktu server — authoritative. Auto-close tidak mengisi ini.
  absenServerPada DateTime

  status       StatusVerifikasi @default(PENDING_VERIFIKASI)
  verifiedBy   User?            @relation("VerifierLogs", fields: [verifiedById], references: [id])
  verifiedById String?
  verifiedAt   DateTime?
  rejectedReason String?

  // Untuk resubmit: kenapa karyawan mengirim ulang
  keteranganKoreksi String?

  // Untuk override oleh admin (mis. karyawan lupa check-out, admin isi manual)
  isOverride Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([jenis])
  @@index([status])
}

model ShiftTemplate {
  id             String   @id @default(cuid())
  store          Store    @relation(fields: [storeId], references: [id])
  storeId        String
  nama           String
  jamMulaiMenit  Int
  jamSelesaiMenit Int
  lintasHari     Boolean  @default(false)
  aktif          Boolean  @default(true)
  // Pola hari kerja: 0=Minggu, 1=Senin, ..., 6=Sabtu
  // Array kosong = SEMUA hari (backward compatible)
  hariKerja      Int[]    @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  instances ShiftInstance[]

  @@unique([storeId, nama])
  @@index([storeId])
}

model ShiftInstance {
  id           String         @id @default(cuid())
  store        Store          @relation(fields: [storeId], references: [id])
  storeId      String
  template     ShiftTemplate? @relation(fields: [templateId], references: [id])
  templateId   String?
  tanggal      DateTime       @db.Date
  jamMulai     DateTime
  jamSelesai   DateTime
  statusJadwal StatusJadwal   @default(DRAFT)
  sumberJadwal SumberJadwal
  catatan      String?

  createdBy    User           @relation("JadwalCreator", fields: [createdById], references: [id])
  createdById  String
  approvedBy   User?          @relation("JadwalApprover", fields: [approvedById], references: [id])
  approvedById String?
  approvedAt   DateTime?

  batchId     String?

  assignments ShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, tanggal])
  @@index([statusJadwal])
  @@index([batchId])
}

model ShiftAssignment {
  id                  String        @id @default(cuid())
  shiftInstance       ShiftInstance @relation(fields: [shiftInstanceId], references: [id], onDelete: Cascade)
  shiftInstanceId     String
  employee            User          @relation("EmployeeShifts", fields: [employeeId], references: [id])
  employeeId          String
  segmen              SegmenShift   @default(NORMAL)
  jamMulai            DateTime
  jamSelesai          DateTime

  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shiftInstanceId])
  @@index([employeeId])
  @@index([segmen])
}

// ============ AGENDA & BONUS ============
// Dua sumber (§6): template_pusat (dibuat Manajer/Supervisor/Admin) & mandiri_karyawan (laporan sendiri).

model Agenda {
  id        String       @id @default(cuid())
  judul     String
  deskripsi String?
  nominal   Int? // bonus per agenda, diisi Manajer setelah verifikasi
  sumber    SumberAgenda

  // Self-relation: agenda ini adalah turunan dari template induk (nullable)
  template   Agenda?  @relation("AgendaTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?
  turunan    Agenda[] @relation("AgendaTemplate")

  // Target opsional: agenda bisa berlaku umum, ke toko tertentu, atau ke karyawan tertentu (§6)
  targetStore      Store?  @relation(fields: [targetStoreId], references: [id])
  targetStoreId    String?
  targetEmployee   User?   @relation("AgendaTarget", fields: [targetEmployeeId], references: [id])
  targetEmployeeId String?

  // Deadline agenda — di-set manajer, nullable (agenda tanpa deadline tetap valid)
  deadline DateTime?

  createdBy   User   @relation("AgendaCreator", fields: [createdById], references: [id])
  createdById String

  status       StatusVerifikasi @default(PENDING_VERIFIKASI)
  verifiedBy   User?            @relation("AgendaVerifier", fields: [verifiedById], references: [id])
  verifiedById String?
  verifiedAt   DateTime?

  // Kapan & siapa yang set nominal (manajer)
  nominalSetBy   User?     @relation("AgendaNominalSetter", fields: [nominalSetById], references: [id])
  nominalSetById String?
  nominalSetAt   DateTime?

  // Bukti penyelesaian (foto, file_id Telegram) — opsional, boleh salah satu atau keduanya
  buktiBeforeFileId String?
  buktiAfterFileId  String?

  // Kapan karyawan menandai agenda ini selesai
  diselesaikanPada DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sumber])
  @@index([status])
  @@index([targetStoreId])
  @@index([targetEmployeeId])
  @@index([templateId])
  @@index([deadline])
  @@index([nominalSetById])
}

// ============ GAJI & PAYROLL (§7) ============

model GajiPokok {
  id         String   @id @default(cuid())
  employee   User     @relation(fields: [employeeId], references: [id])
  employeeId String   @unique
  nominal    Int // ditentukan pusat (Manajer), bukan per toko (§7.1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Satu record per karyawan per bulan — dipakai untuk tipe HARIAN maupun BULANAN,
// bedanya hanya cara `totalGaji` dihitung di level aplikasi (§7.1).
model Payroll {
  id         String   @id @default(cuid())
  employee   User     @relation(fields: [employeeId], references: [id])
  employeeId String
  periode    DateTime // tanggal 1 di bulan terkait, contoh: 2026-09-01

  gajiPokok               Int
  totalHariKerja          Int? // relevan untuk tipe HARIAN
  totalBonusAgenda        Int     @default(0) // dari agenda terverifikasi (§6)
  totalPotonganTelat      Int     @default(0) // dari akumulasi Attendance.potongan (§5.1)
  bonusManual             Int     @default(0) // input manual Manajer (§7.1)
  potonganManual          Int     @default(0) // input manual Manajer (§7.1)
  bonusPerforma           Int     @default(0) // manual sepenuhnya, TIDAK dihitung otomatis (§7.1)
  keteranganBonusPerforma String?

  totalGaji Int // hasil akhir setelah semua komponen di atas dijumlah/dikurangi

  status     String    @default("DRAFT") // DRAFT | LOCKED
  lockedAt   DateTime?
  lockedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periode])
  @@index([periode])
  @@index([status])
}

// ============ AUDIT LOG (§8, §11) ============

model AuditLog {
  id           String   @id @default(cuid())
  tabel        String // nama tabel/entitas yang diubah
  recordId     String // id record yang diubah
  aksi         String // "CREATE" | "UPDATE" | "DELETE"
  nilaiSebelum Json?
  nilaiSesudah Json?
  actor        User     @relation("AuditActor", fields: [actorId], references: [id])
  actorId      String
  alasan       String?
  createdAt    DateTime @default(now())

  @@index([tabel, recordId])
  @@index([actorId])
}

// ============ KODE COUNTER USER ============
// Auto-increment per prefix (DIR, MGR, EMP). Dipakai generate kode user baru.

model KodeCounter {
  prefix     String @id // "DIR" | "MGR" | "EMP"
  lastNumber Int    @default(0)
}

// ============ MODUL PENJUALAN PER TOKO (§4.2) ============
// Sengaja generik (kolom `data` berupa JSON) karena tiap modul (Epos, Brilink, Pulsa,
// Bensin, Nota Harian, Komoditas) punya field berbeda — lihat §4.2 untuk struktur JSON per modul.

model SalesRecord {
  id         String   @id @default(cuid())
  store      Store    @relation(fields: [storeId], references: [id])
  storeId    String
  tanggal    DateTime
  shift      String?
  modul      String // "EPOS" | "BRILINK" | "PULSA" | "BENSIN" | "NOTA_HARIAN" | "KOMODITAS"
  sumberData String   @default("manual") // "manual" | "sinkron_epos" (§4.2.1)
  data       Json // struktur field mengikuti modul, lihat §4.2.1–§4.2.7

  createdAt DateTime @default(now())

  @@index([storeId, tanggal])
  @@index([modul])
}
